# 数字人视频提供商（多选一 + 模拟模式 mock）
PROVIDER=mock               # heygen | did | synthesia | mock | local_open | fal

# fal.ai 托管（零部署，官方 serverless 推理；getting key: fal.ai -> Settings -> API Keys）
FAL_API_KEY=key:secret
FAL_MODEL=fal-ai/sadtalker     # 或 fal-ai/live-portrait 等

# LivePortrait 本地开源引擎（照片→数字人口播；不在本机就跑在 GPU 机器/worker）
LIVEPORTRAIT_URL=http://127.0.0.1:8765
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=V7qG2k3p1s5x9jU0zM6e
DID_API_KEY=
SYNTHESIA_API_KEY=

# TTS（真实模式用）
TTS_PROVIDER=heygen          # heygen | elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa

# 脚本生成 LLM（OpenAI 兼容，可填 DeepSeek/Kimi/OpenAI/通义…）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
